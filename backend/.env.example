# Copy to backend/.env and fill in as needed. Every value has a working default,
# so the app runs with no configuration at all.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# --- Routing -----------------------------------------------------------------
# Optional. With a key the app uses OpenRouteService's heavy-goods-vehicle
# profile, which respects truck weight/height restrictions. Without one it falls
# back to the public OSRM demo server (car profile, rate limited).
# Free key: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org

# --- Geocoding ---------------------------------------------------------------
# Photon handles autocomplete; Nominatim is only the fallback.
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real contact address here.
USER_AGENT=weather-aware-truck-routing/1.0 (you@example.com)

# --- Weather (no key required) -----------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Used automatically when Open-Meteo answers 429 (no key needed).
MET_NORWAY_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0/complete
MET_NORWAY_MAX_WORKERS=8
# Free-tier Open-Meteo allows only one in-flight call; batches run one after another.
WEATHER_BATCH_SIZE=40
WEATHER_MAX_WORKERS=1
WEATHER_MIN_INTERVAL_SECONDS=0.4
WEATHER_CACHE_SECONDS=900

# Which wind figure drives the risk table: max | gust | sustained
WIND_RISK_METRIC=max

# --- CORS --------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com
